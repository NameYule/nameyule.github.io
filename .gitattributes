# Normalize line endings — this repo previously accumulated CRLF churn
# that made every file show as modified. Keep everything as LF in git.
* text=auto eol=lf

# Binary assets must never be normalized
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
*.zip  binary
